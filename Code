        years = list(FOOD_SPENDING_100M.keys())
        food = [trillion(FOOD_SPENDING_100M[y]) for y in years]
        total = [trillion(TOTAL_SPENDING_100M[y]) for y in years]
        arrivals = [ARRIVALS_MILLIONS[y] for y in years]

        BarChart(
            p,
            "Graph 1 — annual food-related inbound spending",
            years, food,
            value_prefix="¥", value_suffix="T",
            color=ACCENT,
            note="¥ trillion. Missing years are omitted, not estimated."
        ).pack(fill="x", padx=22, pady=8)

        BarChart(
            p,
            "Graph 2 — total inbound visitor spending",
            years, total,
            value_prefix="¥", value_suffix="T",
            color=BLUE,
            note="¥ trillion. This includes food, accommodation, shopping, "
                 "transport and other visitor expenses."
        ).pack(fill="x", padx=22, pady=8)

        LineChart(
            p,
            "Graph 3 — food spending vs total inbound spending",
            years,
            [
