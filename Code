        frame = tk.Frame(
            parent, bg=PANEL, highlightbackground=GRID,
            highlightthickness=1
        )
        tk.Label(
            frame, text=label.upper(), bg=PANEL, fg=MUTED,
            font=("Segoe UI", 9, "bold")
        ).pack(anchor="w", padx=14, pady=(12, 2))
        tk.Label(
            frame, text=value, bg=PANEL, fg=color,
            font=("Segoe UI", 22, "bold")
        ).pack(anchor="w", padx=14)
        tk.Label(
            frame, text=explanation, bg=PANEL, fg=TEXT,
            font=("Segoe UI", 9), justify="left",
            wraplength=280
        ).pack(anchor="w", padx=14, pady=(3, 12))
