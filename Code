        self.section(p, "Annual data table")

        table_frame = tk.Frame(p, bg=PANEL)
        table_frame.pack(fill="x", padx=22, pady=(0, 16))

        headers = [
            "Year", "Food spending (¥T)",
            "Total spending (¥T)", "Arrivals (millions)"
        ]

        for col, header in enumerate(headers):
            tk.Label(
                table_frame, text=header, bg=PANEL_2, fg=TEXT,
                font=("Segoe UI", 9, "bold"), anchor="w",
                padx=8, pady=8
            ).grid(row=0, column=col, sticky="nsew")

        for row, year in enumerate(years, start=1):
            vals = [
                str(year),
                f"{trillion(FOOD_SPENDING_100M[year]):.4f}",
                f"{trillion(TOTAL_SPENDING_100M[year]):.4f}",
                f"{ARRIVALS_MILLIONS[year]:.2f}",
            ]
            for col, value in enumerate(vals):
                tk.Label(
                    table_frame, text=value,
                    bg=PANEL if row % 2 else PANEL_2,
                    fg=TEXT, font=("Segoe UI", 9),
                    anchor="w", padx=8, pady=7
                ).grid(row=row, column=col, sticky="nsew")

        for col in range(len(headers)):
            table_frame.grid_columnconfigure(col, weight=1)

        self.card(
            p, "Data warning: 2022",
            "The annual series reports food-related spending of "
            "¥271.5 billion for 2022. Because this is much lower than "
            "2023 and 2024, it should be interpreted in the context of "
            "the reopening of international travel and the survey series. "
            "Do not treat the 2022 value as a normal, uninterrupted year.",
            RED
        )

        self.card(
            p, "What the graphs show",
            "Food-related spending rose by about 68% between 2019 and "
            "2024. Total visitor spending also rose strongly. The two "
            "series move in the same broad direction, but shared movement "
            "does not by itself prove that social media caused either trend.",
            GREEN
        )

    # --------------------------------------------------------
    # SOCIAL MEDIA TIMELINE
    # --------------------------------------------------------

    def _social_timeline(self):
        p = self.tabs["Social Media Timeline"]

        self.section(
            p, "When did the social-media effect begin?",
            "There is no single verified year in these sources when "
            "social media suddenly made Japanese food tourism explode. "
            "Instead, the evidence identifies milestones that can be "
            "compared with tourism spending."
        )

        self.card(
            p, "Important distinction",
            "The timeline combines three kinds of evidence: research on "
            "food content, evidence about social-platform use, and actual "
            "tourism outcomes. These measure different things. A platform "
            "growing does not prove that Japan-food content caused a trip.",
            RED
        )

        for item in SOCIAL_TIMELINE:
            body = (
                f"{item['detail']}\n\n"
                f"Evidence type: {item['kind']}\n"
                f"Interpretation: {item['strength']}"
            )

            if item["year"] == "2018":
                color = PURPLE
            elif item["year"] == "2023":
                color = BLUE
            elif item["year"] == "2024":
                color = GREEN
            elif "2020" in item["year"]:
                color = RED
            else:
                color = ACCENT

            self.card(
                p, f"{item['year']} — {item['title']}",
                body, color
            )

        self.section(p, "The likely pathway to investigate")
        self.card(
            p, "1. Discovery",
            "Short videos, food photography, creator recommendations "
            "and fan communities expose people to ramen, sushi, wagyu, "
            "matcha desserts, convenience-store food and regional dishes.",
            PURPLE
        )
        self.card(
            p, "2. Lower planning friction",
            "Maps, restaurant reviews, translation tools, menus and "
            "travel videos can make it easier for a visitor to find "
            "a restaurant and plan a food-focused itinerary.",
            BLUE
        )
        self.card(
            p, "3. A trip becomes an experience",
            "Visitors may travel to try dishes, visit famous restaurants, "
            "explore markets or experience places associated with anime, "
            "games and Japanese popular culture.",
            GREEN
        )
        self.card(
            p, "4. Spending enters the economy",
            "Food purchases create revenue for restaurants and suppliers. "
            "Travel also generates spending on accommodation, local "
            "transport, shopping and other services.",
            ACCENT
        )

        self.section(p, "What would prove the link more convincingly?")
        self.card(
            p, "A stronger empirical test",
            "Collect monthly or regional data on Japan-food video views "
            "or search interest, visitor arrivals, food spending and "
            "restaurant activity. Compare locations and periods with "
            "different exposure, while controlling for exchange rates, "
            "air capacity, border reopening, seasonality and other "
            "tourism campaigns. The current annual figures alone cannot "
            "estimate a causal effect.",
            RED
        )

    # --------------------------------------------------------
    # ECONOMIC IMPACT
    # --------------------------------------------------------

    def _economic_impact(self):
        p = self.tabs["Economic Impact"]

        self.section(
            p, "Economic impact: GDP, prices and businesses",
            "This section distinguishes observed tourism expenditure "
            "from wider economic effects and from claims that the data "
            "cannot prove."
        )

        self.card(
            p, "1. GDP: direct contribution",
            "Foreign visitors pay Japanese businesses for meals, "
            "accommodation, transport, shopping and experiences. The "
            "value added by Japanese businesses contributes to GDP. "
            "However, gross visitor spending is not the same as GDP: "
            "intermediate inputs and imported goods must be accounted for.",
            GREEN
        )

        self.card(
            p, "2. GDP: indirect and induced effects",
            "Restaurants buy ingredients and services from suppliers. "
            "Hotels, transport operators and other businesses also "
            "serve visitors. Employees and business owners may spend "
            "some of their income in Japan. These are wider economic "
            "effects, but calculating them requires input-output or "
            "tourism satellite-account methods."
        )

        self.card(
            p, "3. Tourism's share of the economy",
            f"WTTC estimated travel and tourism's total contribution "
            f"at about {WTTC_TOTAL_TOURISM_GDP_SHARE_2024:.1f}% of "
            f"Japan's GDP for 2024. OECD reporting puts direct tourism "
            f"at about {OECD_DIRECT_TOURISM_GDP_SHARE_2023:.1f}% of "
            "GDP in 2023. These figures use different years and "
            "methodologies. Neither is the GDP contribution of food "
            "tourism alone.",
            BLUE
        )

        self.card(
            p, "4. Inflation: where price pressure can appear",
            "If tourist demand grows faster than local capacity, "
            "restaurants, hotels, transport or popular neighbourhoods "
            "may experience price pressure. This is a possible local "
            "demand effect—not proof that food tourism caused Japan's "
            "national inflation rate to rise."
        )

        self.card(
            p, "5. Other causes of inflation must be separated",
            "Japan's prices can also be affected by imported energy and "
            "food costs, exchange rates, wages, supply constraints and "
            "broader domestic demand. To estimate tourism's contribution, "
            "research would need price data by location and category, "
            "alongside measures of tourist demand and these other factors.",
            RED
        )

        self.card(
            p, "6. Employment and small businesses",
            "Higher restaurant demand can support chefs, servers, "
            "food producers, delivery services, guides and local shops. "
            "The net effect depends on wages, staffing shortages, "
            "seasonality and whether local businesses retain the revenue."
        )

        self.card(
            p, "7. Convenience and distribution",
            "Convenience stores, station food, vending machines, "
            "cashless payments, restaurant booking tools and map "
            "services can reduce the effort involved in finding food. "
            "These features can improve the visitor experience, but "
            "this dashboard does not measure their separate effect."
        )

        self.card(
            p, "8. Cultural exports and brand value",
            "Food tourism may encourage interest in Japanese ingredients, "
            "cooking, regional specialities and food products. Visitors "
            "may also buy products or recommend places after returning "
            "home. These are plausible spillovers, but their monetary "
            "value is not calculated here."
        )

        self.card(
            p, "9. Costs and uneven distribution",
            "Popular destinations can face crowding, pressure on public "
            "transport, waste, housing or commercial rents. Benefits "
            "may concentrate in famous districts rather than reaching "
            "all regions. These costs matter when judging whether tourism "
            "growth improves residents' welfare overall."
        )

        self.card(
            p, "10. Overall assessment",
            "The evidence supports a conclusion that inbound food "
            "spending became a larger economic flow by 2024. Social "
            "media is a credible discovery and planning mechanism, "
            "but the available figures do not identify its independent "
            "contribution to GDP, inflation or visitor growth. A careful "
            "study should describe the connection as plausible and "
            "consistent with the evidence—not proven causation.",
            ACCENT
        )

        self.section(p, "Key calculations")
        f19 = trillion(FOOD_SPENDING_100M[2019])
        f24 = trillion(FOOD_SPENDING_100M[2024])
        t19 = trillion(TOTAL_SPENDING_100M[2019])
        t24 = trillion(TOTAL_SPENDING_100M[2024])

        self.card(
            p, "Food spending: 2019 → 2024",
            f"¥{f19:.4f}T → ¥{f24:.4f}T\n"
            f"Absolute increase: ¥{f24 - f19:.4f}T\n"
            f"Percentage increase: {pct_change(f19, f24):.1f}%",
            GREEN
        )
        self.card(
            p, "Total inbound spending: 2019 → 2024",
            f"¥{t19:.4f}T → ¥{t24:.4f}T\n"
            f"Absolute increase: ¥{t24 - t19:.4f}T\n"
            f"Percentage increase: {pct_change(t19, t24):.1f}%",
            BLUE
        )

    # --------------------------------------------------------
    # METHOD AND LIMITATIONS
    # --------------------------------------------------------

    def _method(self):
        p = self.tabs["Research Method"]

        self.section(
            p, "Research method and limitations",
            "This is an evidence dashboard, not a causal econometric model."
        )

        self.card(
            p, "Research question",
            "To what extent is the growth of Japanese food tourism "
            "associated with social-media discovery and convenience, "
            "and what measurable economic outcomes accompanied it?"
        )

        self.card(
            p, "Dependent outcomes",
            "Food-related inbound spending, total inbound spending "
            "and visitor arrivals. These show tourism outcomes but "
            "do not identify the reason for each trip."
        )

        self.card(
            p, "Possible explanatory factors",
            "Social-platform use, food-related online content, restaurant "
            "discoverability, cultural fandom, exchange rates, travel "
            "costs, airline capacity, border rules and seasonality."
        )

        self.card(
            p, "Why 2020–2021 matter",
            "COVID-19 and international travel restrictions created "
            "an unusually large disruption. A simple comparison of "
            "2019 and 2024 mixes post-pandemic reopening, changes in "
            "prices, exchange-rate effects, visitor volumes and any "
            "social-media influence."
        )

        self.card(
            p, "Nominal spending versus real growth",
            "The spending figures are nominal yen. Their increase can "
            "reflect more visitors, more spending per visitor, higher "
            "prices or a combination. Without a suitable price adjustment, "
            "the increase should not be described as entirely real growth."
        )

        self.card(
            p, "The food-spending measure",
            "Food-related inbound spending records money spent by "
            "foreign visitors on food-related items. It does not tell "
            "us whether the visitor chose Japan because of a TikTok "
            "video, anime, family recommendations, business travel "
            "or another reason."
        )

        self.card(
            p, "Missing annual observations",
            "The chart uses the annual values supplied by the cited "
            "MAFF presentation. The displayed series has no 2020 or "
            "2021 annual food-spending observations, so those years "
            "are not invented or interpolated."
        )

        self.card(
            p, "A stronger follow-up project",
            "Use monthly data, Google Trends or another documented "
            "search-interest series, publicly documented social-media "
            "metrics, visitor surveys, and regional spending data. "
            "Then test whether changes in online attention precede "
            "changes in food-related travel, while controlling for "
            "other explanations."
        )

        self.card(
            p, "What the current project can conclude",
            "Food-related visitor spending increased substantially "
            "between 2019 and 2024. Research shows that food content "
            "was prominent in Japan's digital culture and that social "
            "platform usage increased. These facts are consistent with "
            "social media helping food tourism, but do not quantify or "
            "prove that effect."
        )

