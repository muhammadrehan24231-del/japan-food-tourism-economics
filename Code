    def section(self, parent, title, subtitle=None):
        tk.Label(
            parent, text=title, bg=BG, fg=TEXT,
            font=("Segoe UI", 17, "bold"), anchor="w"
        ).pack(fill="x", padx=22, pady=(22, 6))

        if subtitle:
            tk.Label(
                parent, text=subtitle, bg=BG, fg=MUTED,
                font=("Segoe UI", 10), anchor="w",
                justify="left", wraplength=1050
            ).pack(fill="x", padx=22, pady=(0, 10))

    def card(self, parent, title, body, accent=ACCENT):
        frame = tk.Frame(
            parent, bg=PANEL, highlightbackground=GRID,
            highlightthickness=1
        )
        frame.pack(fill="x", padx=22, pady=7)

        tk.Frame(frame, bg=accent, width=5).pack(
            side="left", fill="y"
        )
        inner = tk.Frame(frame, bg=PANEL)
        inner.pack(side="left", fill="both", expand=True, padx=14, pady=12)

        tk.Label(
            inner, text=title, bg=PANEL, fg=TEXT,
            font=("Segoe UI", 12, "bold"), anchor="w"
        ).pack(fill="x")

        tk.Label(
            inner, text=body, bg=PANEL, fg=MUTED,
            font=("Segoe UI", 10), anchor="w",
            justify="left", wraplength=1000
        ).pack(fill="x", pady=(5, 0))
        return frame

