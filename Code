class BarChart(tk.Frame):
    def __init__(self, parent, title, labels, values,
                 value_prefix="", value_suffix="", color=ACCENT,
                 note="", height=340):
        super().__init__(parent, bg=PANEL, highlightbackground=GRID,
                         highlightthickness=1)

        tk.Label(
            self, text=title, bg=PANEL, fg=TEXT,
            font=("Segoe UI", 14, "bold"), anchor="w"
        ).pack(fill="x", padx=14, pady=(12, 0))

        if note:
            tk.Label(
                self, text=note, bg=PANEL, fg=MUTED,
                font=("Segoe UI", 9), anchor="w", justify="left",
                wraplength=900
            ).pack(fill="x", padx=14, pady=(4, 0))

        self.chart = tk.Canvas(
            self, bg=PANEL, height=height, highlightthickness=0
        )
        self.chart.pack(fill="x", expand=True, padx=8, pady=8)

        self.labels = labels
        self.values = values
        self.value_prefix = value_prefix
        self.value_suffix = value_suffix
        self.color = color

        self.chart.bind("<Configure>", lambda e: self.draw())

    def draw(self):
        c = self.chart
        c.delete("all")
        w = max(c.winfo_width(), 600)
        h = max(c.winfo_height(), 250)

        left, right, top, bottom = 62, 22, 24, 55
        plot_w = w - left - right
        plot_h = h - top - bottom

        if not self.values or max(self.values) <= 0:
            return

        maximum = max(self.values) * 1.15

        for i in range(5):
            y_val = maximum * i / 4
            y = top + plot_h - (y_val / maximum) * plot_h
            c.create_line(left, y, w - right, y, fill=GRID)
            c.create_text(
                left - 8, y, text=f"{y_val:.1f}",
                fill=MUTED, anchor="e", font=("Segoe UI", 8)
            )

        n = len(self.values)
        slot = plot_w / max(n, 1)
        bar_w = min(42, slot * 0.62)

        for i, (label, value) in enumerate(zip(self.labels, self.values)):
            x = left + slot * i + slot / 2
            bar_h = (value / maximum) * plot_h
            y1 = top + plot_h - bar_h

            c.create_rectangle(
                x - bar_w / 2, y1, x + bar_w / 2,
                top + plot_h, fill=self.color, outline=""
            )
            c.create_text(
                x, max(y1 - 12, 9),
                text=f"{self.value_prefix}{value:,.2f}{self.value_suffix}",
                fill=TEXT, font=("Segoe UI", 8)
            )
            c.create_text(
                x, top + plot_h + 18, text=str(label),
                fill=MUTED, font=("Segoe UI", 8)
            )


class LineChart(tk.Frame):
    def __init__(self, parent, title, labels, series,
                 note="", height=360):
        super().__init__(parent, bg=PANEL, highlightbackground=GRID,
                         highlightthickness=1)

        tk.Label(
            self, text=title, bg=PANEL, fg=TEXT,
            font=("Segoe UI", 14, "bold"), anchor="w"
        ).pack(fill="x", padx=14, pady=(12, 0))

        if note:
            tk.Label(
                self, text=note, bg=PANEL, fg=MUTED,
                font=("Segoe UI", 9), anchor="w", justify="left",
                wraplength=900
            ).pack(fill="x", padx=14, pady=(4, 0))

        self.chart = tk.Canvas(
            self, bg=PANEL, height=height, highlightthickness=0
        )
        self.chart.pack(fill="x", expand=True, padx=8, pady=8)

        self.labels = labels
        self.series = series
        self.chart.bind("<Configure>", lambda e: self.draw())

    def draw(self):
        c = self.chart
        c.delete("all")
        w = max(c.winfo_width(), 600)
        h = max(c.winfo_height(), 260)

        left, right, top, bottom = 62, 28, 36, 58
        plot_w = w - left - right
        plot_h = h - top - bottom

        all_values = []
        for series in self.series:
            all_values.extend(series["values"])

        if not all_values:
            return

        maximum = max(all_values) * 1.12
        if maximum <= 0:
            maximum = 1

        for i in range(5):
            value = maximum * i / 4
            y = top + plot_h - (value / maximum) * plot_h
            c.create_line(left, y, w - right, y, fill=GRID)
            c.create_text(
                left - 8, y, text=f"{value:.1f}",
                fill=MUTED, anchor="e", font=("Segoe UI", 8)
            )

        n = len(self.labels)
        points_x = [
            left + i * (plot_w / max(n - 1, 1))
            for i in range(n)
        ]

        for series_index, series in enumerate(self.series):
            vals = series["values"]
            color = series["color"]
            points = []

            for x, value in zip(points_x, vals):
                y = top + plot_h - (value / maximum) * plot_h
                points.extend([x, y])

            if len(points) >= 4:
                c.create_line(
                    *points, fill=color, width=3, smooth=False
                )

            for i, value in enumerate(vals):
                x = points_x[i]
                y = top + plot_h - (value / maximum) * plot_h
                c.create_oval(
                    x - 4, y - 4, x + 4, y + 4,
                    fill=color, outline=""
                )

            legend_x = left + series_index * 205
            c.create_line(
                legend_x, 16, legend_x + 24, 16,
                fill=color, width=3
            )
            c.create_text(
                legend_x + 31, 16, text=series["name"],
                fill=TEXT, anchor="w", font=("Segoe UI", 9)
            )

        for i, label in enumerate(self.labels):
            c.create_text(
                points_x[i], top + plot_h + 20,
                text=str(label), fill=MUTED,
                font=("Segoe UI", 8)
            )


