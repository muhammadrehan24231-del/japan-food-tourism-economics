            note="Both series use the same unit. The 2020–2021 gap reflects "
                 "missing years in this annual series; do not read a line "
                 "between 2019 and 2022 as a continuous annual trend."
        ).pack(fill="x", padx=22, pady=8)

        BarChart(
            p,
            "Graph 4 — inbound tourist arrivals",
            years, arrivals,
            value_suffix="M",
            color=GREEN,
            note="Millions of visitors. The pandemic period sharply disrupted "
                 "international travel."
